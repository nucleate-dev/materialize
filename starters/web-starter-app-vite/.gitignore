# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm-cache/

# testing
coverage/

# vite
client/dist/
client/dist-ssr/

# production
build/

# misc
.DS_Store
*.pem
*.local

# debug / logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# env files (can opt-in for committing if needed)
.env*
**/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# sensitive local files
.gitconfig
.bash_history

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
