# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any level)
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions
**/.npm-cache/

# bun (any level)
**/bun.lockb
**/.bun/
**/.bun-cache/

# testing (any level)
**/coverage/

# build outputs (any level)
**/dist/
**/dist-ssr/
**/build/
**/out/

# vite (any level)
**/*.local

# next.js (any level)
**/.next/
**/next-env.d.ts

# supabase (any level)
**/.supabase/
**/supabase/.temp/
**/supabase/.branches/

# convex (any level)
**/.convex/
**/convex/_generated/

# env files (any level)
**/.env
**/.env.*
**/.env*.local

# misc
**/.DS_Store
**/*.pem

# debug / logs (any level)
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnpm-debug.log*
**/lerna-debug.log*

# vercel (any level)
**/.vercel/

# typescript (any level)
**/*.tsbuildinfo

# sensitive local files
**/.gitconfig
**/.bash_history

# Editor directories and files (any level)
**/.vscode/*
!**/.vscode/extensions.json
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?
