{
  "name": "async-backfills",
  "version": "1.0.0",
  "description": "Database backfill scripts for Nucleate",
  "private": true,
  "scripts": {
    "gen:supabase:types": "supabase gen types typescript --project-id hfgjmwidcoszkmvejxhw --schema public > types/supabase.ts",
    "exec": "ts-node --project tsconfig.json",
    "backfill": "ts-node --project tsconfig.json run-fixer.ts",
    "build": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
