{
  "name": "rn-web-build-worker",
  "version": "1.0.0",
  "description": "Build worker for React Native Web app building service",
  "main": "dist/worker.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/worker.js",
    "dev": "sudo -E env \"PATH=$PATH\" sh -c 'PORT=3002 nodemon 2>&1 | tee -a /home/ec2-user/build-workers/dev-server.log'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "prebuild": "npm run lint:check",
    "test:build": "node --loader ts-node/esm testscripts/test-build-endpoint.ts",
    "test:deploy": "node --loader ts-node/esm testscripts/test-deploy-endpoint.ts",
    "test:build-deploy": "node --loader ts-node/esm testscripts/test-build-and-deploy-endpoint.ts",
    "test:local": "node --loader ts-node/esm testscripts/test-build-and-deploy-endpoint.ts --local",
    "test:public-dev-server": "node --loader ts-node/esm testscripts/test-public-dev-server-endpoint.ts",
    "test:public-dev-server:local": "node --loader ts-node/esm testscripts/test-public-dev-server-endpoint.ts --local",
    "typecheck": "tsc -p . --noEmit",
    "gen:supabase:types": "supabase gen types typescript --project-id hfgjmwidcoszkmvejxhw --schema public > types/supabase.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.44",
    "@ai-sdk/openai": "^2.0.79",
    "@anthropic-ai/claude-agent-sdk": "^0.1.73",
    "@aws-sdk/client-s3": "^3.937.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.24.1",
    "@supabase/supabase-js": "^2.86.0",
    "ai": "^5.0.108",
    "axios": "^1.13.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.2",
    "node-pty": "^1.0.0",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.1",
    "posthog-node": "^5.17.4",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react-native",
    "web",
    "build",
    "worker",
    "fastify"
  ],
  "author": "",
  "license": "ISC"
}
