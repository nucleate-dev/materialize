{
  "name": "rn-web-build-worker",
  "version": "1.0.0",
  "description": "Build worker for React Native Web app building service",
  "main": "dist/worker.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/worker.js",
    "dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "prebuild": "npm run lint:check",
    "test:build": "node --loader ts-node/esm testscripts/test-build-endpoint.ts",
    "test:deploy": "node --loader ts-node/esm testscripts/test-deploy-endpoint.ts",
    "test:build-deploy": "node --loader ts-node/esm testscripts/test-build-and-deploy-endpoint.ts",
    "test:local": "node --loader ts-node/esm testscripts/test-build-and-deploy-endpoint.ts --local",
    "test:public-dev-server": "node --loader ts-node/esm testscripts/test-public-dev-server-endpoint.ts",
    "test:public-dev-server:local": "node --loader ts-node/esm testscripts/test-public-dev-server-endpoint.ts --local"
  },
  "dependencies": {
    "aws-sdk": "^2.1582.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pino-pretty": "^13.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-sdk": "^2.7.0",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react-native",
    "web",
    "build",
    "worker",
    "fastify"
  ],
  "author": "",
  "license": "ISC"
}
