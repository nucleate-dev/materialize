{
  "name": "rn-web-control-plane",
  "version": "1.0.0",
  "description": "Control plane for React Native Web app building service",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "dev": "sh -c 'tsx watch server.ts 2>&1 | tee -a /home/ec2-user/control-plane/dev-server.log'",
    "gen:supabase:types": "supabase gen types typescript --project-id hfgjmwidcoszkmvejxhw --schema public > types/supabase.ts",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "sync-types": "node scripts/sync-types.js",
    "sync-build-worker-types": "node scripts/sync-build-worker-types.js",
    "prebuild": "npm run lint:check && npm run sync-types"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.17",
    "@ai-sdk/google": "^2.0.7",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-ec2": "^3.888.0",
    "@aws-sdk/client-ecs": "^3.864.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/credential-provider-node": "^3.864.0",
    "@aws-sdk/protocol-http": "^3.370.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@aws-sdk/util-format-url": "^3.862.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^6.12.0",
    "@supabase/supabase-js": "^2.54.0",
    "@valkey/valkey-glide": "^2.0.1",
    "ai": "^5.0.18",
    "aws-sdk": "^2.1491.0",
    "axios": "^1.6.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "pm2": "^6.0.8",
    "stripe": "^17.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react-native",
    "web",
    "build",
    "control-plane",
    "fastify"
  ],
  "author": "",
  "license": "ISC"
}
